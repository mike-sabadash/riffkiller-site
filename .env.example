# Riff Killer - Environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Canonical site URL (for OAuth redirect_uri). Set on production so Google/Yandex callbacks work.
# Example: SITE_URL=https://riffkiller.fun
# SITE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Cryptomus (https://cryptomus.com)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Patreon (monetization). Premium = active paid membership in this campaign.
# Campaign ID: see docs/PATREON_SETUP.md. Tier IDs are optional (comma-separated);
# without them any paid tier of the campaign gives premium.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# PATREON_TIER_IDS=
# Patreon → Developer portal → Webhooks → secret
PATREON_WEBHOOK_SECRET=

# Admin panel /admin/ and test-account links
ADMIN_PASSWORD=
ADMIN_SECRET=

# Internal API key for api/subscription/update.php (endpoint is disabled while empty)
# SUBSCRIPTION_UPDATE_SECRET=

# Email campaigns (Resend)
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=Riff Killer <hello@your-domain.com>
# Optional webhook secret (match in Resend webhook settings)
# RESEND_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth web application; values from the downloaded OAuth client JSON.
# Authorized redirect URI: https://riffkiller.fun/api/auth/google-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Card payments. A method appears on billing.html once its keys are set.
# lava.top (cards worldwide, USD): Profile → API key; create a subscription product with
# monthly and yearly prices and put its offer id here (LAVA_OFFER_ID_YEARLY if yearly is a separate offer).
# Webhook in lava.top: https://riffkiller.fun/api/billing/lava-webhook.php, auth "API key" = LAVA_WEBHOOK_SECRET
# (any long random string you choose).
# LAVA_API_KEY=
# LAVA_OFFER_ID=
# LAVA_OFFER_ID_YEARLY=
# LAVA_WEBHOOK_SECRET=
# Prices in RUB for Robokassa and YooKassa
# BILLING_RUB_MONTHLY=
# BILLING_RUB_YEARLY=
# Robokassa: shop login and passwords #1/#2 (technical settings). ResultURL (POST):
# https://riffkiller.fun/api/billing/robokassa-result.php, SuccessURL: https://riffkiller.fun/billing.html?paid=robokassa,
# FailURL: https://riffkiller.fun/billing.html?failed=robokassa. ROBOKASSA_TEST=1 uses the test passwords.
# ROBOKASSA_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_TEST=
# YooKassa: shopId and secret key (Integration → API keys). HTTP notifications:
# https://riffkiller.fun/api/billing/yookassa-webhook.php with payment.succeeded and payment.canceled.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
