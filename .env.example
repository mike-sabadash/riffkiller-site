# Riff Killer - Environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Canonical site URL (for OAuth redirect_uri). Set on production so Google/Yandex callbacks work.
# Example: SITE_URL=https://riffkiller.fun
# SITE_URL=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Cryptomus (https://cryptomus.com)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Patreon (monetization). Premium = active paid membership in this campaign.
# Campaign ID: see docs/PATREON_SETUP.md. Tier IDs are optional (comma-separated);
# without them any paid tier of the campaign gives premium.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
# PATREON_TIER_IDS=
# Patreon → Developer portal → Webhooks → secret
PATREON_WEBHOOK_SECRET=
# The server's region is blocked by Patreon; requests go through the Vercel proxy.
# Default: https://patreon-proxy-vercel.vercel.app/api/exchange ; "off" = call Patreon directly.
# PATREON_PROXY_URL=

# Admin panel /admin/ and test-account links
ADMIN_PASSWORD=
ADMIN_SECRET=

# Internal API key for api/subscription/update.php (endpoint is disabled while empty)
# SUBSCRIPTION_UPDATE_SECRET=

# Email campaigns (Resend)
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=Riff Killer <hello@your-domain.com>
# Optional webhook secret (match in Resend webhook settings)
# RESEND_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth web application; values from the downloaded OAuth client JSON.
# Authorized redirect URI: https://riffkiller.fun/api/auth/google-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
