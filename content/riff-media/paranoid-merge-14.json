  "dna": {
   "overview": "Paranoid is two organisms. The intro hook works inside one E5 shape at the 12th fret: three hits with a 12–14 hammer-on, then a short run across the A and D strings. The verse riff is an engine: palm-muted, down-picked E5 eighths, a whole step down to D5, and a quick G5 – D5 – E5 turn back home. Later passes hold the E5 and slide down into G5 instead.",
   "rule": "Muted E5 eighths + drop to D5 + G5–D5 turn home",
   "law": "The eighths never stop and never change length, so the only movement you hear is harmonic: home, a step down, a short turn up and back. Because the pulse is fixed, the turn feels like an engine changing gear, not a new idea.",
   "failure": "Alternate-pick or open up the palm mute and the riff loses its weight; skip the G5 before the D5 and the turn no longer pulls home.",
   "authorNotes": "",
   "preserve": [
    "Down-picked, palm-muted E5 eighths",
    "The drop a whole step to D5",
    "The G5 – D5 – E5 turn back home",
    "The 12–14 hammer-on inside the E5 shape in the intro"
   ],
   "change": [
    "How many E5 bars come before the drop",
    "How long the E5 is held in the tag",
    "Which top-string chord answers the E5",
    "Where the slide into G5 starts"
   ],
   "mutation": {
    "title": "Build a Paranoid relative — without copying the riff",
    "description": "Keep the engine, not the notes: one home power chord in steady eighths, a step down, and a short turn home.",
    "steps": [
     "Pick a home power chord and play 16 palm-muted, down-picked eighths on it.",
     "Drop a whole step for one bar with the same eighths.",
     "Write a two-chord turn — a fourth above, then the step down — and land home on beat 3.",
     "On the last pass hold the home chord for a bar and slide down into the turn instead."
    ]
   },
