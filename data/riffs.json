        "dna": {
            "overview": "Black Dog lives inside a conversation. The voice leaves a gap, the guitar jumps in off balance, winds through short cells, turns and lands on E.",
            "rule": "The cells are simple. The phrase is uneven.",
            "law": "Each cell is short and easy to remember, but where it falls against the beat and the vocal gaps breaks the square feel. Landing on E5 puts the ground back under it.",
            "preserve": [
                "The gap before the guitar comes in",
                "The off-balance entry",
                "Launch, then turn, then land",
                "The landing on E"
            ],
            "change": [
                "The middle notes",
                "The register",
                "How many times a cell repeats",
                "Articulation"
            ],
            "failure": "You remove the gap, the turn or the landing on E. The notes stay, the riff disappears.",
            "atoms": [
                {
                    "technique": "accent",
                    "label": "Off-beat entry",
                    "tip": "Come in right after the gap, a hair early. Count the gap, not the notes.",
                    "time": 0.05,
                    "segmentIndex": 0,
                    "view": "right",
                    "speed": 0.5
                },
                {
                    "technique": "legato",
                    "label": "7–5–6–7",
                    "tip": "Watch the left hand leave the 7th fret and come straight back; pick only the first note.",
                    "time": 0.5,
                    "segmentIndex": 0,
                    "view": "left",
                    "speed": 0.5
                },
                {
                    "technique": "qbend",
                    "label": "5th fret",
                    "tip": "Just a nudge, not a full half step. Compare the hand with the tab.",
                    "time": 2.1,
                    "segmentIndex": 1,
                    "view": "split",
                    "speed": 0.5
                },
                {
                    "technique": "anchor",
                    "label": "E5 (0–2–2)",
                    "tip": "Land firmly and let it ring: this is home.",
                    "time": 3.1,
                    "segmentIndex": 1,
                    "view": "right",
                    "speed": 0.75
                }
            ],
            "mutation": {
                "title": "Write a riff in the same spirit",
                "description": "Keep the uneven entry and the landing, not the notes.",
                "steps": [
                    "Leave a short gap, then come in with a three- or four-note cell in 5/8.",
                    "Answer it in 4/4 and land clearly on a new root.",
                    "Add one technique: a small bend, a rake or a slide.",
                    "Play the pair three times, then change only the last landing. That change is your hook."
                ]
            }
        }
