        "dna": {
            "overview": "Black Dog feels like one long, unpredictable phrase. Under the surface it is a two-molecule organism: a displaced statement and a resolving answer, repeated until the landing feels inevitable.",
            "formula": "5/8 STATEMENT + 4/4 ANSWER + QUARTER-TONE ATTITUDE",
            "structure": [
                "A",
                "B",
                "A",
                "B",
                "A",
                "B"
            ],
            "law": "The hook does not come from a large collection of notes. Molecule A compresses the pulse, molecule B restores the ground, and their alternation keeps moving the listener between instability and return.",
            "insight": "The supplied notation exposes the fingerprint: the statement is grouped in 5/8 before the answer returns to 4/4. The phrase sounds free, but its asymmetry is organized.",
            "atoms": [
                {
                    "type": "Pulse",
                    "label": "The 5/8 compression",
                    "tip": "Count the short statement as its own cell. Do not force it into four beats.",
                    "segmentIndex": 0,
                    "view": "right",
                    "speed": 0.5
                },
                {
                    "type": "Shape",
                    "label": "7–5–6–7 contour",
                    "tip": "Watch the left hand as the compact contour leaves and returns to the seventh fret.",
                    "segmentIndex": 0,
                    "view": "left",
                    "speed": 0.5
                },
                {
                    "type": "Touch",
                    "label": "Quarter-tone bend",
                    "tip": "This is attitude, not a full semitone target. Compare the fretting hand with the tab marking.",
                    "segmentIndex": 1,
                    "view": "split",
                    "speed": 0.5
                },
                {
                    "type": "Return",
                    "label": "Answer lands in 4/4",
                    "tip": "Hear how the answer makes the preceding asymmetry feel intentional.",
                    "segmentIndex": 1,
                    "view": "right",
                    "speed": 0.75
                }
            ],
            "mutation": {
                "title": "Build a Black Dog relative — without copying the riff",
                "description": "Preserve the asymmetrical relationship, not the original notes. This turns analysis into vocabulary.",
                "steps": [
                    "Create a short five-eighths statement from a different three- or four-note contour.",
                    "Answer it in four-four and land clearly on a new root note.",
                    "Add one expressive atom — a quarter-tone bend, rake or slide — but keep the rhythmic law intact.",
                    "Play A → B three times, then change only the final answer. That change becomes your hook."
                ]
            }
        }
